	<queryString>
		<![CDATA[SELECT cp.id_compra, u.nome AS cliente, j.titulo AS jogo, cp.valor_pago, cp.data_compra FROM compra cp INNER JOIN usuario u ON cp.id_usuario = u.id_usuario INNER JOIN jogo j ON cp.id_jogo = j.id_jogo ORDER BY cp.id_compra]]>
	</queryString>
	<field name="id_compra" class="java.lang.Integer"/>
	<field name="cliente" class="java.lang.String"/>
	<field name="jogo" class="java.lang.String"/>
	<field name="valor_pago" class="java.math.BigDecimal"/>
	<field name="data_compra" class="java.sql.Timestamp"/>
