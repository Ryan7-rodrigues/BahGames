	<queryString>
		<![CDATA[SELECT j.id_jogo, j.titulo, c.nome AS categoria, j.preco, j.data_lancamento FROM jogo j INNER JOIN categoria c ON j.id_categoria = c.id_categoria ORDER BY j.id_jogo]]>
	</queryString>
